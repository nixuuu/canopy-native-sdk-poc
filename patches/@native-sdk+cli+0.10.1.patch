+/// One stable registration in the Darwin kqueue reactor. Registrations are
+/// retained until reactor teardown so a queued kernel event can never point at
+/// freed memory; `active` and `generation` make stale events inert.
+const PtyReactorEntry = struct {
+    // Registration publishes the entry to kqueue before it becomes active.
+    // An immediately-ready fd may therefore produce a harmless ignored event,
+    // while a partially failed registration can never be serviced.
+    active: std.atomic.Value(bool) = std.atomic.Value(bool).init(false),
+    reclaim_after: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
+    shared: *PtyShared,
+    transport: pty_transport.Pty,
+    generation: u64,
+};
+
