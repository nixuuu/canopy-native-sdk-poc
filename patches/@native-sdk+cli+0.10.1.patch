+    allocator: std.mem.Allocator,
+    platform: pty_transport.Reactor,
+    mutex: SpinMutex = .{},
+    entries: std.ArrayListUnmanaged(*PtyReactorEntry) = .empty,
+    shutdown: std.atomic.Value(bool) = std.atomic.Value(bool).init(false),
+    epoch: std.atomic.Value(u64) = std.atomic.Value(u64).init(1),
+    thread: std.Thread,
+
+    fn create(allocator: std.mem.Allocator) ?*PtyReactor {
+        if (comptime !pty_transport.reactor_supported) return null;
+        const reactor = allocator.create(PtyReactor) catch return null;
+        const reactor_platform = pty_transport.Reactor.init() catch {
+            allocator.destroy(reactor);
+            return null;
+        };
+        reactor.* = .{
+            .allocator = allocator,
+            .platform = reactor_platform,
+            .thread = undefined,
+        };
+        reactor.thread = std.Thread.spawn(.{}, run, .{reactor}) catch {
+            reactor.platform.deinit();
+            allocator.destroy(reactor);
+            return null;
+        };
+        return reactor;
+    }
