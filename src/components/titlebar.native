<!-- Window chrome and global workspace actions. -->
<template name="app-titlebar">
  <row height="40" padding="6" gap="6" cross="center" background="surface" window-drag="true" label="Canopy title bar">
    <spacer width="{chrome_leading}" />
    <text size="sm" foreground="text_muted">canopy</text>
    <spacer grow="1" />
    <text size="sm">{activeWorkspaceName}</text>
    <spacer grow="1" />
    <button size="sm" variant="ghost" icon="folder-open" on-press="open_folder" label="Attach folder" disabled="{attachDisabled}">Attach</button>
    <if test="{hasProjects}"><button size="sm" variant="ghost" icon="plus" on-press="open_active_terminal" label="New terminal">New</button></if>
    <button width="24" height="24" size="icon" variant="ghost" icon="settings" on-press="open_preferences" label="Open preferences" disabled="{preferencesDisabled}"></button>
  </row>
</template>
