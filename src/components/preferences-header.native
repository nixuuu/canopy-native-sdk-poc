<!-- Shared compact window chrome; search aligns with the content column. -->
<template name="preferences-header">
  <row height="52" padding="12" gap="12" cross="center" background="surface">
    <row width="192" padding="4" cross="center">
      <text size="heading"><span weight="medium">Settings</span></text>
    </row>
    <search-field grow="1" height="32" text="{preferencesSearchText}" placeholder="Search settings…" on-input="edit_preferences_search" label="Search settings" />
    <button width="28" height="28" size="icon" variant="ghost" icon="x" on-press="close_preferences" label="Close settings"></button>
  </row>
</template>
