<!-- Shared agent launcher: spacing stays consistent with the compact sidebar. -->
<template name="agent-launcher" args="agent name expanded profiles count running">
  <column gap="1" key="{agent}">
    <if test="{count > 1}">
      <list-item height="28" padding="4" gap="5" cross="center" on-press="toggle_agent_profiles:{agent}" expanded="{expanded}" label="{name ++ ' profiles'}">
        <icon name="chevron-right" width="10" height="10" foreground="text_muted" />
        <icon name="terminal" width="12" height="12" foreground="accent" />
        <text size="sm" grow="1">{name}</text>
        <if test="{running > 0}"><badge>{running}</badge></if>
        <else><badge variant="outline">{count}</badge></else>
      </list-item>
      <if test="{expanded}">
        <for each="profiles" key="key" as="profile">
          <list-item height="24" padding="4" gap="5" cross="center" tree-level="2" on-press="launch_profile:{profile.id}" label="{profile.name}">
            <spacer width="18" />
            <icon name="circle-dot" width="8" height="8" foreground="text_muted" />
            <text size="sm" grow="1" wrap="false">{profile.name}</text>
          </list-item>
        </for>
      </if>
    </if>
    <else>
      <list-item height="28" padding="4" gap="5" cross="center" on-press="launch_agent:{agent}" label="{'Launch ' ++ name}">
        <icon name="terminal" width="12" height="12" foreground="accent" />
        <text size="sm" grow="1">{name}</text>
        <if test="{running > 0}"><badge>{running}</badge></if>
      </list-item>
    </else>
  </column>
</template>

<template name="tools-sidebar">
  <column label="Tools">
    <separator />
    <column padding="4" gap="1">
      <row height="24" padding="4" cross="center">
        <text size="sm" foreground="text_muted" grow="1">TOOLS</text>
        <if test="{toolsReady}"><button width="20" height="20" size="icon" variant="ghost" icon="settings" on-press="open_claude_preferences" label="Configure agent profiles"></button></if>
      </row>
      <if test="{toolsLoading}">
        <text size="sm" foreground="text_muted">Discovering installed tools...</text>
      </if>
      <else>
        <if test="{claude_available}">
          <use template="agent-launcher" agent="claude" name="Claude Code" expanded="{claude_expanded}" profiles="{claudeProfiles}" count="{claudeProfileCount}" running="{claudeRunningCount}" />
        </if>
        <if test="{codex_available}">
          <use template="agent-launcher" agent="codex" name="Codex" expanded="{codex_expanded}" profiles="{codexProfiles}" count="{codexProfileCount}" running="{codexRunningCount}" />
        </if>
        <if test="{noAgentToolsAvailable}"><text size="sm" foreground="text_muted">No configured agent CLI is available.</text></if>
      </else>
    </column>
  </column>
</template>
