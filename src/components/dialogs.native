<!-- Modal workflows remain separate components but bind the shared app model. -->
<import src="primitives.native"/>
<template name="create-worktree-dialog">
  <panel background="scrim" label="Create worktree backdrop">
    <column grow="1" main="center" cross="center">
      <dialog width="400" height="190" background="surface" label="Create Worktree" on-dismiss="cancel_create_worktree">
        <column padding="16" gap="10">
          <text size="heading">New worktree</text>
          <text size="sm" foreground="text_muted">Create a new branch and checkout for {createProjectName}.</text>
          <text-field text="{createBranchText}" placeholder="feature/my-change" autofocus="true" on-input="edit_create_branch" on-submit="confirm_create_worktree" label="Branch name" />
          <spacer grow="1" />
          <use template="dialog-actions">
            <button variant="ghost" on-press="cancel_create_worktree">Cancel</button>
            <button variant="primary" on-press="confirm_create_worktree" disabled="{createDisabled}">Create</button>
          </use>
        </column>
      </dialog>
    </column>
  </panel>
</template>

<template name="profile-switch-dialog">
  <panel background="scrim" label="Discard profile changes backdrop">
    <column grow="1" main="center" cross="center">
      <dialog width="400" height="180" background="surface" label="Discard Profile Changes" on-dismiss="cancel_profile_switch">
        <column padding="16" gap="10">
          <text size="heading">Discard unsaved changes?</text>
          <text foreground="text_muted" wrap="true">You have unsaved changes in the current profile. Discard them and continue?</text>
          <spacer grow="1" />
          <use template="dialog-actions">
            <button variant="ghost" on-press="cancel_profile_switch">Cancel</button>
            <button variant="destructive" on-press="confirm_profile_switch">Discard</button>
          </use>
        </column>
      </dialog>
    </column>
  </panel>
</template>

<template name="profile-delete-dialog">
  <panel background="scrim" label="Delete profile backdrop">
    <column grow="1" main="center" cross="center">
      <dialog width="400" height="180" background="surface" label="Delete Profile" on-dismiss="cancel_delete_profile">
        <column padding="16" gap="10">
          <text size="heading">Delete {profileDeleteName}?</text>
          <text foreground="text_muted" wrap="true">This profile will be removed. Running terminal sessions are not affected.</text>
          <spacer grow="1" />
          <use template="dialog-actions">
            <button variant="ghost" on-press="cancel_delete_profile">Cancel</button>
            <button variant="destructive" on-press="confirm_delete_profile">Delete</button>
          </use>
        </column>
      </dialog>
    </column>
  </panel>
</template>

<template name="remove-worktree-dialog">
  <panel background="scrim" label="Remove worktree backdrop">
    <column grow="1" main="center" cross="center">
      <dialog width="420" height="240" background="surface" label="Remove Worktree" on-dismiss="cancel_remove_worktree">
        <column padding="16" gap="10">
          <text size="heading">Remove {removeWorktreeName}?</text>
          <text size="sm" foreground="text_muted" wrap="true">{removeWorktreePath}</text>
          <if test="{removeHasWarnings}">
            <alert variant="destructive" text="This worktree needs explicit force consent.">
              <column gap="4">
                <if test="{removeMissing}"><text size="sm">The directory is missing. Only its Git registration will be removed.</text></if>
                <if test="{removeDirty}"><text size="sm">It contains uncommitted changes.</text></if>
                <if test="{removeHasSubmodules}"><text size="sm">It contains submodule configuration that Git may refuse to remove safely.</text></if>
                <if test="{removeUnmergedCount > 0}"><text size="sm">{removeUnmergedCount} commit(s) are not present on any remote.</text></if>
              </column>
            </alert>
          </if>
          <else><text size="sm">The checkout is clean. Its branch will be kept.</text></else>
          <spacer grow="1" />
          <use template="dialog-actions">
            <button variant="ghost" on-press="cancel_remove_worktree">Cancel</button>
            <button variant="destructive" on-press="confirm_remove_worktree" disabled="{gitBusy}">Remove</button>
          </use>
        </column>
      </dialog>
    </column>
  </panel>
</template>

<template name="detach-project-dialog">
  <panel background="scrim" label="Detach project backdrop">
    <column grow="1" main="center" cross="center">
      <dialog width="400" height="180" background="surface" label="Detach Project" on-dismiss="cancel_detach_project">
        <column padding="16" gap="10">
          <text size="heading">Detach {detachProjectName}?</text>
          <text wrap="true" foreground="text_muted">Open terminals owned by this project will be closed. No project files or Git worktrees will be deleted.</text>
          <spacer grow="1" />
          <use template="dialog-actions">
            <button variant="ghost" on-press="cancel_detach_project">Cancel</button>
            <button variant="primary" on-press="confirm_detach_project" disabled="{gitBusy}">Detach</button>
          </use>
        </column>
      </dialog>
    </column>
  </panel>
</template>
