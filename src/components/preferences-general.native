<template name="preferences-general">
  <column padding="24" gap="16">
    <row gap="24" cross="center">
      <column grow="1" gap="4">
        <text size="lg">Reopen attached projects</text>
        <text foreground="text_muted">Restore the previous project list when Canopy starts.</text>
      </column>
      <switch disabled="{preferences_edit.saving}" selected="{preferencesReopenLast}" on-toggle="toggle_preferences_reopen" label="Reopen attached projects on startup" />
    </row>
  </column>
</template>
