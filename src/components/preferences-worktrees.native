<template name="preferences-worktrees">
  <column padding="24" gap="12">
    <column gap="4">
      <text size="sm" foreground="disabled"><span scale="0.91" weight="medium">WORKTREE LOCATIONS</span></text>
      <text size="sm" foreground="text_muted">Configure where Canopy creates native Git worktrees.</text>
    </column>
    <column padding="12" gap="8">
      <text size="lg">Base directory</text>
      <text size="sm" foreground="text_muted">Leave empty to use the default directory shown below.</text>
      <text-field disabled="{preferences_edit.saving}" size="lg" height="33" text="{preferencesBaseDirText}" placeholder="{preferencesDefaultBaseDir}" on-input="edit_preferences_base_dir" label="Worktrees base directory" />
      <if test="{preferencesBaseDirInvalid}"><text size="sm" foreground="destructive">Enter an absolute directory path.</text></if>
      <else><text size="sm" foreground="text_muted"><span mono="true">{preferencesDefaultBaseDir}</span></text></else>
    </column>
  </column>
</template>
