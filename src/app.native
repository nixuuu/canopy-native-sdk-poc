<!-- Canopy's project -> worktree -> tabs shape, rendered entirely by Native SDK. -->
<import src="components/primitives.native"/>
<import src="components/titlebar.native"/>
<import src="components/project-sidebar.native"/>
<import src="components/terminal-workspace.native"/>
<import src="components/empty-state.native"/>
<import src="components/dialogs.native"/>
<import src="components/preferences.native"/>

<stack grow="1">
  <column grow="1" background="background">
    <use template="app-titlebar" />
    <separator />

    <if test="{hasProjects}">
      <split grow="1" value="{sidebar_fraction}" on-resize="sidebar_resized" gap="1">
        <use template="project-sidebar" />
        <use template="terminal-workspace" />
      </split>
    </if>
    <else>
      <use template="project-empty-state" />
    </else>

    <status-bar>{status_text} · Ghostty · host-limited sessions</status-bar>
  </column>

  <if test="{create_dialog_open}"><use template="create-worktree-dialog" /></if>
  <if test="{remove_dialog_open}"><use template="remove-worktree-dialog" /></if>
  <if test="{detach_dialog_open}"><use template="detach-project-dialog" /></if>
  <if test="{preferences_open}"><use template="preferences-dialog" /></if>
  <if test="{profile_switch_dialog_open}"><use template="profile-switch-dialog" /></if>
  <if test="{profile_delete_dialog_open}"><use template="profile-delete-dialog" /></if>
</stack>
